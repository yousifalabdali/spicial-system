{
  "name": "sales-inventory-pro",
  "productName": "Sales Inventory Pro",
  "version": "1.0.0",
  "description": "نظام إدارة المخزون والمبيعات",
  "author": "Yousuf",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "build:server": "vite build --config vite.server.config.ts",
    "start": "node dist-server/index.cjs",
    "web": "npm run build && npm run build:server && node dist-server/index.cjs",
    "local": "npm run web",
    "build:web": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "nodemailer": "^7.0.13",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-electron": "^1.1.2"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "electron@44.5.1": true
  },
  "build": {
    "appId": "com.salesinventorypro.app",
    "productName": "Sales Inventory Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**",
      "package.json"
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": [
            "dmg",
            "nsis"
          ],
          "arch": [
            "arm64",
            "x64",
            "ia32"
          ]
        }
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Sales Inventory Pro",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "toolsets": {
      "nsis": "1.2.1"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
