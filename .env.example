# Copy the variables you need into Vercel (Project Settings -> Environment Variables)
# or export them before running `node dist-server/index.cjs`. Never commit real values.

# Supabase -> Project Settings -> Database -> Connection string -> Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres

# Needed once, to create the first super admin account on the website
SETUP_CODE=change-me

# Optional
APP_TIMEZONE=Asia/Muscat
# SEED_DEMO=1        fill an empty database with demo data
# DATA_DIR=./data    local database folder when DATABASE_URL is not set

# ---- Run fully on this computer (no Vercel, no Supabase) ----
# Copy this file to .env, leave DATABASE_URL out (delete or comment it), then: npm run local
# The data is kept in ./data, and http://localhost:3000 behaves exactly like the website.
# PORT=3000

# ---- Low-stock emails (Settings -> تنبيهات المخزون بالبريد) ----
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your@gmail.com,
# SMTP_PASS=an "App password" (Google Account -> Security -> App passwords), not your normal password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=
# SMTP_FROM="Sales Inventory Pro <you@gmail.com>"
